# ─────────────────────────────────────────────────────────────────────────────
# Over-Sat CRM — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (safe to expose — used client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose — used client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role key (SECRET — server-side only, never prefix with NEXT_PUBLIC_)
# Required for User Management (create / delete / update users)
# Get it from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Email digest (optional — mailer is a no-op without these) ─────────────────
# SMTP server for the daily notifications digest (06:00 UTC Vercel cron)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Over-Sat CRM <noreply@example.com>"

# Bearer token protecting /api/notifications/digest (set the same value in Vercel)
CRON_SECRET=generate_a_long_random_string
